# Environment Variables for RapidAid AI Backend
# Copy this file to .env and fill in your actual API keys

# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Database URL (Required for production on Render)
# For PostgreSQL on Render: postgresql://username:password@host:port/database
# Leave empty for local development (will use SQLite)
DATABASE_URL=